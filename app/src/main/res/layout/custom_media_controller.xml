<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#80000000"
    android:padding="8dp">

    <!-- প্রোগ্রেস বার এবং টাইম ভিউ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:text="00:00"
            android:paddingEnd="8dp"/>

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:text="00:00"
            android:paddingStart="8dp"/>
    </LinearLayout>

    <!-- কন্ট্রোলার বাটন বার (স্ক্রিনশট অনুযায়ী ক্রমানুসারে) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="4dp">

        <!-- ১. রিসাইজ বাটন -->
        <ImageButton
            android:id="@+id/btnResize"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_crop"
            android:contentDescription="Resize"/>

        <!-- ২. মাল্টি-অডিও ট্র্যাক সিলেক্টর বাটন -->
        <ImageButton
            android:id="@+id/exo_audio_track"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Multi Audio"/>

        <!-- ৩. পিকচার-ইন-পিকচার (PiP) বাটন -->
        <ImageButton
            android:id="@+id/btnPip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="PiP Mode"/>

        <!-- ৪. রিওয়াইন্ড বাটন -->
        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_rew"
            android:contentDescription="Rewind"/>

        <!-- ৫. প্লে / পজ বাটন -->
        <ImageButton
            android:id="@id/exo_play"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Play"/>

        <ImageButton
            android:id="@id/exo_pause"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_pause"
            android:contentDescription="Pause"/>

        <!-- ৬. ফরওয়ার্ড বাটন -->
        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_ff"
            android:contentDescription="Fast Forward"/>

        <!-- ৭. সাবটাইটেল বাটন -->
        <ImageButton
            android:id="@id/exo_subtitle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_alphabetically"
            android:contentDescription="Subtitles"/>

        <!-- ৮. সেটিংস / রেজুলেশন গিয়ার বাটন -->
        <ImageButton
            android:id="@+id/exo_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="Resolution Settings"/>

        <!-- ৯. ফুলস্ক্রিন / অ্যাসপেক্ট রেশিও বাটন -->
        <ImageButton
            android:id="@id/exo_fullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_zoom"
            android:contentDescription="Fullscreen"/>

    </LinearLayout>
</LinearLayout>
